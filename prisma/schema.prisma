// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String        @id @default(uuid())
  email     String        @unique
  name      String?       @default("")
  username  String        @unique
  avatar    String?       @default("")
  password  String
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  posts     Post[]
  sessions  UserSession[]
  Todo      Todo[]
}

model UserSession {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  expiresAt DateTime
  token     String   @unique
  user      User     @relation(fields: [userId], references: [id])
  userId    String

  // Optimize performance: prevents full table scans when looking up sessions by user
  @@index([userId])
}

model Post {
  id        String   @id @default(uuid())
  title     String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  author    User     @relation(fields: [authorId], references: [id])
  authorId  String

  // Optimize performance: prevents full table scans when looking up posts by author
  @@index([authorId])
}

model Todo {
  id        Int   @id @default(autoincrement())
  task      String
  done      Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId    String
  user      User     @relation(fields: [userId], references: [id])

  // Optimize performance: prevents full table scans when looking up todos by user
  @@index([userId])
}
